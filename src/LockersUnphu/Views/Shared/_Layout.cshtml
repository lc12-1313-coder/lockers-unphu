<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Lockers UNPHU</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable" href="#contenido">Ir al contenido</a>
    <header class="cabecera">
        <div class="container py-3 d-flex flex-wrap align-items-center gap-3">
            <a asp-controller="Home" asp-action="Index">UNPHU · Biblioteca</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Cuenta" asp-action="Clave">Mi cuenta</a>
                <form asp-controller="Cuenta" asp-action="Salir" method="post">
                    <button type="submit" class="btn btn-outline-light">Salir</button>
                </form>
            }
        </div>
    </header>
    <main id="contenido" class="container py-5">
        @RenderBody()
    </main>
</body>
</html>
