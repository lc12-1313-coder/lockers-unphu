@model ErrorViewModel
@{
    ViewData["Title"] = "Servicio no disponible";
}
<h1>Servicio no disponible</h1>
<p class="mt-3">Vuelve a intentarlo en unos minutos.</p>
@if (Model.ShowRequestId)
{
    <p>Referencia de la solicitud <code>@Model.RequestId</code></p>
}
<a asp-controller="Home" asp-action="Index">Volver al inicio</a>
