@model IngresoForm
@{
    ViewData["Title"] = "Iniciar sesión";
}
<h1>Iniciar sesión</h1>
<p>Usa tu cuenta del sistema de lockers.</p>
<form asp-action="Ingresar" method="post" class="formulario-cuenta">
    <input asp-for="ReturnUrl" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div>
        <label asp-for="Usuario"></label>
        <input asp-for="Usuario" class="form-control" autocomplete="username" maxlength="64" required />
        <span asp-validation-for="Usuario" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Clave"></label>
        <input asp-for="Clave" class="form-control" autocomplete="current-password" maxlength="128" required />
        <span asp-validation-for="Clave" class="text-danger"></span>
    </div>
    <button class="btn btn-success" type="submit">Ingresar</button>
</form>
