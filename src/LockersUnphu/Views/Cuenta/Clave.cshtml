@model ClaveForm
@{
    ViewData["Title"] = "Mi cuenta";
}
<header class="encabezado">
    <h1>Mi cuenta</h1>
    <p class="secundario">@User.Identity?.Name</p>
</header>
<section class="panel panel-estrecho" aria-labelledby="titulo-clave">
    <h2 id="titulo-clave">Cambiar contraseña</h2>
    <form asp-action="Clave" method="post" class="formulario">
        <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
        <div>
            <label asp-for="Actual"></label>
            <input asp-for="Actual" class="form-control" autocomplete="current-password" maxlength="128" required />
            <span asp-validation-for="Actual" class="validation"></span>
        </div>
        <div>
            <label asp-for="Nueva"></label>
            <input asp-for="Nueva" class="form-control" autocomplete="new-password" minlength="12" maxlength="128" aria-describedby="reglas-clave" required />
            <span asp-validation-for="Nueva" class="validation"></span>
            <partial name="_ReglasClave" />
        </div>
        <button type="submit" class="btn btn-primary">Guardar contraseña</button>
    </form>
</section>
